# Leave both blank to run in Demo Mode (sync across tabs of ONE browser, no backend needed).
# Fill both in to use Supabase Realtime (real phones, multiple devices).
# In Bolt.new, connecting Supabase from the Bolt UI fills these in for you.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: public address used in QR codes / join links (e.g. your deployed Netlify URL).
# If blank, the current browser address is used.
VITE_PUBLIC_URL=
